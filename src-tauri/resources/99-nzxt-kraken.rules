# Kraken LCD: the active seat's user gets access (uaccess), plus members of plugdev for headless use.
SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="3008", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="3009", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="300c", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="300e", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1e71", ATTR{idProduct}=="3012", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", TAG+="uaccess", MODE="0660", GROUP="plugdev"

# Fan control through hwmon sysfs (AMD GPU, it87 and nct677x motherboard headers): writable by plugdev only.
# "$$" is udev's escape for a literal "$" inside RUN.
KERNEL=="hwmon[0-9]*", SUBSYSTEM=="hwmon", ATTR{name}=="amdgpu|it87|nct677[569]", \
  RUN+="/bin/sh -c 'for f in /sys%p/pwm[0-9] /sys%p/pwm[0-9]_enable /sys%p/fan[0-9]_target; do [ -f \"$$f\" ] && chgrp plugdev \"$$f\" && chmod g+w \"$$f\"; done; exit 0'"
